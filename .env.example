# PostgreSQL
POSTGRES_USER=user
POSTGRES_PASSWORD=change-me-in-production
POSTGRES_DB=trading

# Auth Service
DATABASE_URL_AUTH=postgresql://user:change-me-in-production@postgres:5432/trading?schema=auth
JWT_SECRET=change-me-in-production
JWT_EXPIRATION=3600

# Backend
DATABASE_URL_TRADING=postgresql://user:change-me-in-production@postgres:5432/trading?schema=trading
AUTH_SERVICE_URL=http://auth-service:8001
MODEL_CHECKPOINT_PATH=/app/model/best_model.pt
MODEL_CONFIG_PATH=/app/model/model_config.json
BANK_SPREAD_MULTIPLIER=1.0
ALLOWED_ORIGINS=http://localhost:3000

# Frontend (desarrollo)
VITE_FRONTEND_PORT=3000
VITE_AUTH_API_URL=http://localhost:8001
VITE_BACKEND_API_URL=http://localhost:8000

# Nginx (producción)
AUTH_SERVICE_NAME=auth-service
AUTH_SERVICE_PORT=8001
BACKEND_SERVICE_NAME=backend
BACKEND_PORT=8000
